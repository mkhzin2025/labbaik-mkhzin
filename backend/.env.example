# Database Connections (Docker Defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=labbaik_db

MONGO_URL=mongodb://admin:password123@localhost:27017/labbaik_chats?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Configuration
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE

# Security
JWT_SECRET=LABBAIK_SECRET_2026
JWT_EXPIRATION=1d

# Public URL used to generate tenant-specific Meta webhook callback URLs
PUBLIC_API_URL=https://api.example.com

# Meta / WhatsApp Cloud API
# Latest Graph API at the time of this implementation (Sep 2026)
META_GRAPH_API_VERSION=v26.0
# Required for tenants using the shared Labbaik Meta App. For BYO App, the tenant App Secret is encrypted per connection.
META_APP_SECRET=PASTE_LABBAIK_META_APP_SECRET_HERE

# Encrypts tenant access tokens, app secrets and verify tokens at rest.
# Use a long random production secret and do not rotate it without a key migration plan.
CREDENTIAL_ENCRYPTION_KEY=PASTE_A_LONG_RANDOM_SECRET_HERE

# SaaS Billing / Platform Administration
# Comma-separated emails allowed to access /billing/admin/*
PLATFORM_ADMIN_EMAILS=owner@example.com
FRONTEND_URL=https://app.example.com

# Moyasar - Labbaik's own merchant account
# Publishable key is intentionally returned to the authenticated frontend for direct card payment creation.
MOYASAR_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Secret key stays backend-only.
MOYASAR_SECRET_KEY=sk_test_REPLACE_ME
# Configure this same value in Moyasar Dashboard -> Settings -> Webhooks.
MOYASAR_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# Wallet billing rates are Labbaik's own commercial rates, not official Meta pricing.
# 1.0 = SAR 1.00 per billable usage. Supports up to 6 decimals internally.
BILLING_DEFAULT_META_RATE_SAR=0.05
# Optional per-usage overrides. If omitted, BILLING_DEFAULT_META_RATE_SAR is used.
# BILLING_META_SESSION_TEXT_RATE_SAR=0.05
# BILLING_META_INTERACTIVE_RATE_SAR=0.05
# BILLING_META_MARKETING_RATE_SAR=0.05
# BILLING_META_UTILITY_RATE_SAR=0.05
# BILLING_META_AUTH_RATE_SAR=0.05
# BILLING_META_OTHER_RATE_SAR=0.05

# Enable on only one application replica until a distributed scheduler/lease is introduced.
BILLING_RENEWAL_WORKER_ENABLED=true

# Keep false in production. Use explicit migrations/schema scripts.
TYPEORM_SYNCHRONIZE=false
